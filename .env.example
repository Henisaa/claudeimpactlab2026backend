# Backend ETC — Claude Impact Lab 2026 (Línea 03)
# Copiar a .env y ajustar. Todo dato es sintético; nunca uses valores reales.

# --- Servidor -----------------------------------------------------------------
PORT=4000
# En producción (NODE_ENV=production) HTTP plano está prohibido salvo ALLOW_HTTP=true.
NODE_ENV=development
ALLOW_HTTP=true
# TLS configurable: si ambas rutas existen, el servidor levanta HTTPS.
# TLS_CERT_PATH=./certs/cert.pem
# TLS_KEY_PATH=./certs/key.pem

# --- Base de datos --------------------------------------------------------------
# Archivo SQLite (se crea solo desde src/schema.sql al arrancar).
DB_PATH=./data/prototipo.db

# --- Sesión ---------------------------------------------------------------------
# Obligatorio fuera del modo demo: sin JWT_SECRET el servidor no arranca en
# producción ni cuando DEMO_MODE=false.
JWT_SECRET=cambia-esto-en-cualquier-entorno-real
JWT_EXPIRES_IN=2h

# --- Cifrado AES-256-GCM ----------------------------------------------------------
# Obligatorio en producción: clave para campos sensibles, archivos clínicos y
# contenido RAG del paciente. Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# --- Claude -----------------------------------------------------------------------
# CLAUDE_MOCK=true → respuestas simuladas determinísticas (tests y demo sin gasto).
# Modo real: CLAUDE_MOCK=false + ANTHROPIC_API_KEY.
CLAUDE_MOCK=true
ANTHROPIC_API_KEY=
CLAUDE_MODELO=claude-sonnet-5
CLAUDE_MODELO_VISION=claude-opus-5

# --- Demo -------------------------------------------------------------------------
# DEMO_MODE=true permite valores por defecto de JWT_SECRET y ENCRYPTION_KEY
# (solo para la demo y los tests, nunca para un despliegue real).
DEMO_MODE=true

# --- Vault (solo seed) ------------------------------------------------------------
# Carpeta del vault Obsidian con las fuentes oficiales para el corpus RAG.
VAULT_DIR=../claudeimpactlab2026obsidian

# --- Avisos a la persona de apoyo (WhatsApp) --------------------------------------
# El mensaje NUNCA lleva datos clínicos ni el nombre de la paciente (ver
# src/notificaciones.js) y no se envía sin consentimiento `contacto_telefonico`.
#
#   simulado        → redacta y registra el mensaje sin salir a internet (por
#                     defecto: la demo funciona sin ninguna cuenta).
#   whatsapp_cloud  → API oficial de Meta. Requiere cuenta Meta Business y un
#                     número; el número de prueba envía hasta a 5 destinatarios
#                     verificados sin revisión. Fuera de la ventana de 24 h los
#                     mensajes iniciados por el negocio exigen plantilla aprobada
#                     (los nombres están en PLANTILLAS de notificaciones.js).
#   twilio          → sandbox de WhatsApp: el destinatario manda "join <código>"
#                     al número de Twilio y queda habilitado. El más rápido para
#                     una demo; no sirve para producción.
NOTIFICACIONES_PROVEEDOR=simulado

# Enlace que se incluye en el aviso (el detalle vive detrás de la sesión).
APP_URL=http://localhost:3000

# whatsapp_cloud
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
